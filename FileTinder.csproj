<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Winnow</AssemblyName>
    <RootNamespace>FileTinder</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!-- MediaDevices 1.10.2 (MIT) – local reference because NuGet cache is restricted in this env -->
    <Reference Include="MediaDevices">
      <HintPath>lib\MediaDevices.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
