<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Winnow</AssemblyName>
    <RootNamespace>FileTinder</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Version drives the IsNewer() check in UpdateService — must stay above latest GitHub release -->
    <Version>1.2.0</Version>
    <!-- Visible release label format: vyyyyMMdd.increment-for-the-day -->
    <InformationalVersion>20260712.10</InformationalVersion>
  </PropertyGroup>

  <!-- ── Microsoft Store (MSIX) build configuration ── -->
  <!-- Build with: dotnet publish -c Store -r win-x64 -->
  <PropertyGroup Condition="'$(Configuration)'=='Store'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Disable GitHub self-updater — the Store handles updates -->
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Store / MSIX visual assets -->
    <Content Include="Assets\**\*.png" Condition="Exists('Assets')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- MediaDevices 1.10.2 (MIT) – local reference because NuGet cache is restricted in this env -->
    <Reference Include="MediaDevices">
      <HintPath>lib\MediaDevices.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
