<Window x:Class="FileTinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileTinder.ViewModels"
        xmlns:views="clr-namespace:FileTinder.Views"
        xmlns:conv="clr-namespace:FileTinder.Converters"
        Title="Winnow PC File Cleaner"
        Icon="app.ico"
        Width="1020" Height="720"
        MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
    </Window.Resources>

    <!-- Window-level keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="R"      Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Z"      Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title bar -->
            <RowDefinition Height="Auto"/>  <!-- update banner -->
            <RowDefinition Height="Auto"/>  <!-- folder picker -->
            <RowDefinition Height="Auto"/>  <!-- filter bar -->
            <RowDefinition Height="Auto"/>  <!-- session banner -->
            <RowDefinition Height="Auto"/>  <!-- cache banner -->
            <RowDefinition Height="*"/>     <!-- main area -->
        </Grid.RowDefinitions>

        <!-- ════════════════════  TITLE BAR  ════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔥" FontSize="22" Margin="0,0,10,0"
                               FontFamily="Segoe UI Emoji"
                               Foreground="#FF6B35"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Winnow" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <Border Background="#1A7C3AED" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="File cleaner" FontSize="11"
                                           Foreground="{StaticResource AccentBrandBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AppDisplayVersion, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="1,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sound + shortcuts controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Speedup toggle button -->
                    <Button x:Name="SpeedupToggleButton"
                            Cursor="Hand" Padding="10,5" Margin="0,0,10,0"
                            ToolTip="Easy Speedup — optimize startup time"
                            AutomationProperties.Name="Easy Speedup"
                            Click="SpeedupToggleButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=SpeedupToggleButton}" Value="Active">
                                        <Setter Property="Background"   Value="#2563EB"/>
                                        <Setter Property="BorderBrush"  Value="#2563EB"/>
                                        <Setter Property="Foreground"   Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" FontFamily="Segoe UI Emoji"/>
                            <TextBlock x:Name="SpeedupButtonLabel" Text="Speedup" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Cleanup toggle button -->
                    <Button x:Name="CleanupToggleButton"
                            Cursor="Hand" Padding="10,5" Margin="0,0,10,0"
                            ToolTip="PC Cleanup — free up disk space"
                            AutomationProperties.Name="PC Cleanup"
                            Click="CleanupToggleButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=CleanupToggleButton}" Value="Active">
                                        <Setter Property="Background"   Value="#7C3AED"/>
                                        <Setter Property="BorderBrush"  Value="#7C3AED"/>
                                        <Setter Property="Foreground"   Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,6,0" FontFamily="Segoe UI Emoji"/>
                            <TextBlock x:Name="CleanupButtonLabel" Text="Cleanup" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Shortcuts overlay button -->
                    <Button x:Name="ShortcutsButton"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="Keyboard shortcuts (?)"
                            AutomationProperties.Name="Show keyboard shortcuts"
                            Click="ShortcutsButton_Click">
                        <TextBlock Text="?" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════  UPDATE BANNER  ════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#1210B981"
                BorderBrush="#3010B981"
                BorderThickness="0,0,0,1"
                Padding="20,8"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🆕" FontSize="15" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="Winnow v" Foreground="#6EE7B7"/>
                        <Run Text="{Binding UpdateVersion, Mode=OneWay}" FontWeight="Bold" Foreground="#6EE7B7"/>
                        <Run Text=" is available" Foreground="#A7F3D0"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Download progress (shown while downloading) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Downloading…" FontSize="12" Foreground="#6EE7B7"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Maximum="100"
                                     Width="100" Height="8" VerticalAlignment="Center"
                                     Foreground="#10B981" Background="#1A10B981"/>
                        <TextBlock Text="{Binding UpdateDownloadProgress, Mode=OneWay, StringFormat={}{0}%}"
                                   FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                    <!-- Install button (hidden while downloading) -->
                    <Button x:Name="InstallUpdateBtn"
                            Command="{Binding InstallUpdateCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Cursor="Hand"
                            ToolTip="Download and install the update (app will restart)"
                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisInv}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Setter Property="Background" Value="#10B981"/>
                                <Setter Property="BorderBrush"  Value="#059669"/>
                                <Setter Property="Foreground"   Value="White"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇ " FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Download &amp; Install"/>
                        </StackPanel>
                    </Button>
                    <!-- Dismiss -->
                    <Button Command="{Binding DismissUpdateCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6,4"
                            ToolTip="Dismiss this update notification">
                        <TextBlock Text="✕" FontSize="13" Foreground="#6EE7B7"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════  FOLDER PICKER  ════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource PathTextBoxStyle}"
                             Text="{Binding FolderPath, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BrowseButton_Click"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Browse"/>
                        </StackPanel>
                    </Button>

                    <!-- Browse connected device (MTP / iPhone / Android) -->
                    <Button Grid.Column="2"
                            x:Name="BrowseDeviceButton"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BrowseDeviceButton_Click"
                            ToolTip="Browse a connected phone or device"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📱" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Device"/>
                        </StackPanel>
                    </Button>

                    <!-- Backup button — visible only when an MTP device is loaded -->
                    <Button Grid.Column="3"
                            x:Name="BackupDeviceButton"
                            Style="{StaticResource BrowseButtonStyle}"
                            Click="BackupDeviceButton_Click"
                            ToolTip="Copy folders from connected device to PC"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsMtpSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Backup"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Re-scan folder (clears cache)"
                            AutomationProperties.Name="Re-scan folder"
                            Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="↺ Reload"/>
                    </Button>

                    <!-- Folder presets dropdown -->
                    <Button Grid.Column="5"
                            x:Name="PresetsButton"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="PresetsButton_Click"
                            Margin="6,0,0,0"
                            ToolTip="Pinned folders — quick access"
                            AutomationProperties.Name="Pinned folders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="Presets"/>
                        </StackPanel>
                    </Button>
                <Popup x:Name="PresetsPopup"
                       PlacementTarget="{Binding ElementName=PresetsButton}"
                       Placement="Bottom"
                       StaysOpen="False">
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="200">
                        <StackPanel x:Name="PresetsStack">
                            <!-- Filled from code-behind -->
                        </StackPanel>
                    </Border>
                </Popup>
                </Grid>

                <!-- Subfolder selection pill — shown when custom folders are active -->
                <Border Margin="0,6,0,0"
                        Visibility="{Binding HasCustomScanFolders, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                                CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0"
                                           FontFamily="Segoe UI Emoji"/>
                                <TextBlock Text="{Binding ScanFolderSummary}" FontSize="12"
                                           Foreground="{StaticResource AccentBrandBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding PickSubfoldersCommand}"
                                Margin="8,0,0,0" Padding="8,4" FontSize="12"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Change which subfolders to scan">
                            <TextBlock Text="Change"/>
                        </Button>
                        <Button Command="{Binding PickSubfoldersCommand}"
                                CommandParameter="all"
                                Margin="4,0,0,0" Padding="8,4" FontSize="12"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Clear folder selection and scan everything"
                                Click="ClearSubfolderSelection_Click">
                            <TextBlock Text="✕ Scan all"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════════════  FILTER BAR  ═══════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10"
                Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
            <DockPanel VerticalAlignment="Center">

                <!-- View mode toggle buttons (right side) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="View:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="SwipeModeBtn"
                            Content="🃏 Swipe"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="SwipeModeBtn_Click"
                            Tag="Swipe">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSwipeMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="GridModeBtn"
                            Content="⊞ Grid"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="GridModeBtn_Click"
                            Tag="Grid">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ListModeBtn"
                            Content="☰ List"
                            FontSize="12"
                            Padding="10,5"
                            Cursor="Hand"
                            Click="ListModeBtn_Click"
                            Tag="List">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Existing filter controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Type:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TypeFilterCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="TypeFilterCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Modified:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DateFilterCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="DateFilterCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Sort:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="SortCombo_SelectionChanged"/>
                </StackPanel>

                <!-- Subfolders toggle pill -->
                <Border x:Name="SubfolderPill"
                        CornerRadius="14"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="SubfolderPill_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SubfolderCheckMark"
                                   Text="📂"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Subfolders"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubfolderOnBadge"
                                   Text=" ON"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrandBrush}"
                                   Visibility="{Binding IncludeSubfolders, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="SubfolderOffBadge"
                                   Text=" OFF"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IncludeSubfolders, Converter={StaticResource BoolToVisInv}}"/>
                    </StackPanel>
                </Border>

                <!-- Select specific subfolders to scan (local folders only) -->
                <Button Command="{Binding PickSubfoldersCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Padding="9,4" Margin="0,0,16,0" FontSize="12"
                        ToolTip="Choose which subfolders to include in the scan"
                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗂" FontSize="12" Margin="0,0,5,0" FontFamily="Segoe UI Emoji"/>
                        <TextBlock Text="Select Folders"/>
                    </StackPanel>
                </Button>

                <!-- Scan status indicator -->
                <TextBlock FontSize="12" Foreground="{StaticResource AccentBucketBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding ScanStatusText}"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,12,0"/>

                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding QueueInfo}"/>

                <!-- Total size of files matching current filters -->
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                    <Run Text="·" Foreground="{StaticResource BorderSubtleBrush}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding FilteredTotalSizeFormatted, Mode=OneWay}"
                         Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    <Run Text=" total"/>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════  SESSION BANNER  ══════════════════════════ -->
        <Border Grid.Row="4"
                Background="#1A3B82F6"
                BorderBrush="#4A3B82F6"
                BorderThickness="0,0,0,1"
                Padding="24,8"
                Visibility="{Binding HasSessionBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding SessionBanner}"
                           FontSize="13" Foreground="#A0C4FF"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="4"
                        Command="{Binding StartFreshCommand}"
                        ToolTip="Clear saved session and restart from the beginning">
                    <TextBlock Text="Start fresh ↺" FontSize="12"
                               Foreground="#6A90C0"
                               TextDecorations="Underline"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════  CACHE BANNER  ════════════════════════════ -->
        <Border Grid.Row="5"
                Background="#1410B981"
                BorderBrush="#2810B981"
                BorderThickness="0,0,0,1"
                Padding="24,6"
                Visibility="{Binding ShowCacheBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"
                               FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="Loaded from cache" Foreground="#6EE7B7" FontWeight="SemiBold"/>
                        <Run Text=" · scanned " Foreground="#5CA08A"/>
                        <Run Text="{Binding CacheAgeText, Mode=OneWay}" Foreground="#6EE7B7"/>
                    </TextBlock>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="4"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Re-scan now (clears cache)">
                    <TextBlock Text="↺ Re-scan" FontSize="12"
                               Foreground="#5CA08A"
                               TextDecorations="Underline"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════  CLEANUP PANEL  ═══════════════════════ -->
        <views:CleanupView x:Name="CleanupPanel"
                           Grid.Row="6"
                           Visibility="Collapsed"/>

        <!-- ════════════════  SPEEDUP PANEL  ════════════════════════ -->
        <views:SpeedupView x:Name="SpeedupPanel"
                           Grid.Row="6"
                           Visibility="Collapsed"/>

        <!-- ════════════════  MAIN AREA  ════════════════════════════ -->
        <Grid x:Name="MainAreaGrid" Grid.Row="6" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Card + Action buttons ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Swipe mode -->
                <views:CardStackControl Grid.Row="0"
                                        x:Name="CardStack"
                                        DataContext="{Binding}"
                                        Focusable="True"
                                        Visibility="{Binding IsSwipeMode, Converter={StaticResource BoolToVis}}"/>

                <!-- Grid mode -->
                <views:FileGridView Grid.Row="0"
                                    x:Name="GridView"
                                    DataContext="{Binding}"
                                    Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>

                <!-- List mode -->
                <views:FileListView Grid.Row="0"
                                    x:Name="ListView"
                                    DataContext="{Binding}"
                                    Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}"/>

                <!-- Action Buttons -->
                <Grid Grid.Row="1" Margin="0,24,0,0"
                      Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- UNDO button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0"
                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding UndoCommand}"
                                    ToolTip="Undo last delete (Ctrl+Z)"
                                    AutomationProperties.Name="Undo last delete"
                                    Padding="10,10"
                                    Margin="0,0,0,6">
                                <TextBlock Text="↩" FontSize="18"/>
                            </Button>
                            <TextBlock Text="Undo" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- DELETE button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                            <Button Style="{StaticResource DeleteButtonStyle}"
                                    Click="DeleteButton_Click"
                                    ToolTip="Delete (← arrow key)"
                                    AutomationProperties.Name="Delete file"
                                    Margin="0,0,0,6">
                                <TextBlock Text="✕"/>
                            </Button>
                            <TextBlock Text="Delete" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- BUCKET button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                            <Button Style="{StaticResource BucketButtonStyle}"
                                    x:Name="BucketButton"
                                    Click="BucketButton_Click"
                                    AutomationProperties.Name="Add to review bucket"
                                    Margin="0,0,0,6">
                                <TextBlock Text="🪣"/>
                            </Button>
                            <TextBlock Text="Bucket (B)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- KEEP button -->
                        <StackPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource KeepButtonStyle}"
                                    Click="KeepButton_Click"
                                    ToolTip="Keep (→ arrow key)"
                                    AutomationProperties.Name="Keep file"
                                    Margin="0,0,0,6">
                                <TextBlock Text="✓"/>
                            </Button>
                            <TextBlock Text="Keep" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── Right: Stats + Buckets panel ── -->
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">

                <!-- Recently Deleted toggle button -->
                <Grid Margin="0,0,0,10"
                      Visibility="{Binding HasDeletedEntries, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RECENTLY DELETED"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleDeletedPanelCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4,2"
                            ToolTip="Show/hide deleted files panel"
                            AutomationProperties.Name="Toggle deleted files panel">
                        <Border Background="#1AFF6B6B" CornerRadius="10" Padding="6,2">
                            <TextBlock Text="{Binding DeletedEntries.Count}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#FF6B6B"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- Deleted files panel -->
                <views:DeletedFilesPanel DataContext="{Binding}"
                                         Visibility="{Binding ShowDeletedPanel, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,0,14"/>

                <TextBlock Text="SESSION STATS"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"
                           AutomationProperties.HeadingLevel="Level2"/>

                <views:StatsPanel DataContext="{Binding}" Margin="0,0,0,12"/>

                <Button Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ResetStatsCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,20">
                    <TextBlock Text="↺ Reset stats"/>
                </Button>

                <!-- Review Buckets section -->
                <Grid Margin="0,0,0,10"
                      Visibility="{Binding HasBuckets, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="REVIEW BUCKETS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <Button Grid.Column="1"
                            x:Name="NewBucketButton"
                            Click="NewBucketHeader_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4,2"
                            ToolTip="Create new bucket"
                            AutomationProperties.Name="Create new bucket">
                        <TextBlock Text="⊕" FontSize="16"
                                   Foreground="{StaticResource AccentBucketBrush}"/>
                    </Button>
                </Grid>

                <views:BucketsPanel x:Name="BucketsPanelControl"
                                    Visibility="{Binding HasBuckets, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16"/>

                <!-- Tip box -->
                <Border Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12"
                        AutomationProperties.Name="Keyboard shortcuts">
                    <StackPanel>
                        <TextBlock Text="⌨ Keyboard shortcuts"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"
                                   AutomationProperties.HeadingLevel="Level3"/>

                        <!-- Shortcut rows: kbd badge + label -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="←" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Delete file" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="→" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Keep file" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="B" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Add to new bucket" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="O" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Open in default app" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="L" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Open file location" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ════════════  INITIAL SCAN OVERLAY  ════════════════════════
             Shown while scanning a NEW source for the first time.
             Blocks interaction until the full file list is ready.
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Grid.RowSpan="5"
              Panel.ZIndex="20"
              Visibility="{Binding IsLoadingInitial, Converter={StaticResource BoolToVis}}">
            <!-- Frosted dark backdrop -->
            <Border Background="#E81A1A2E"/>

            <!-- Centred card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="48,40"
                    MinWidth="360">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Animated spinner ring -->
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Width="64" Height="64"
                                 Stroke="#2A7C3AED" StrokeThickness="6"/>
                        <Ellipse x:Name="SpinnerArc"
                                 Width="64" Height="64"
                                 Stroke="#7C3AED" StrokeThickness="6"
                                 StrokeDashArray="25 75"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="SpinnerRotate"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360"
                                                Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <!-- Source name -->
                    <TextBlock Text="{Binding ScanSourceText}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="300"
                               Margin="0,0,0,6"/>

                    <!-- Subtitle -->
                    <TextBlock Text="Scanning your files…"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Live progress counts -->
                    <Border Background="#1A7C3AED" CornerRadius="8" Padding="16,10" Margin="0,0,0,20">
                        <TextBlock Text="{Binding ScanStatusText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrandBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Indeterminate progress bar -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Width="260"
                                 Margin="0,0,0,24"
                                 BorderThickness="0"
                                 Foreground="#7C3AED"
                                 Background="#2A2A44"/>

                    <!-- Cancel button -->
                    <Button Command="{Binding CancelScanCommand}"
                            HorizontalAlignment="Center"
                            Padding="20,8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource BorderSubtleBrush}"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ " FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
