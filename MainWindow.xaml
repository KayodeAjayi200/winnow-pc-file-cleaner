<Window x:Class="FileTinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileTinder.ViewModels"
        xmlns:views="clr-namespace:FileTinder.Views"
        xmlns:conv="clr-namespace:FileTinder.Converters"
        Title="Winnow PC File Cleaner"
        Icon="app.ico"
        Width="1020" Height="720"
        MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title bar -->
            <RowDefinition Height="Auto"/>  <!-- update banner -->
            <RowDefinition Height="Auto"/>  <!-- folder picker -->
            <RowDefinition Height="Auto"/>  <!-- filter bar -->
            <RowDefinition Height="Auto"/>  <!-- session banner -->
            <RowDefinition Height="*"/>     <!-- main area -->
        </Grid.RowDefinitions>

        <!-- ════════════════════  TITLE BAR  ════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔥" FontSize="22" Margin="0,0,10,0"
                               FontFamily="Segoe UI Emoji"
                               Foreground="#FF6B35"/>
                    <TextBlock Text="Winnow" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                    <Border Background="#1A7C3AED" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="File cleaner" FontSize="11"
                                   Foreground="{StaticResource AccentBrandBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Sound + shortcuts controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Shortcuts overlay button -->
                    <Button x:Name="ShortcutsButton"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="Keyboard shortcuts (?)"
                            AutomationProperties.Name="Show keyboard shortcuts"
                            Click="ShortcutsButton_Click">
                        <TextBlock Text="?" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="MuteButton"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6,2"
                            ToolTip="Toggle mute"
                            AutomationProperties.Name="Toggle mute"
                            Click="MuteButton_Click">
                        <TextBlock x:Name="MuteIcon" Text="🔊" FontSize="16"
                                   FontFamily="Segoe UI Emoji"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Slider x:Name="VolumeSlider"
                            Minimum="0" Maximum="1"
                            Value="0.55"
                            Width="80"
                            VerticalAlignment="Center"
                            ToolTip="Volume"
                            AutomationProperties.Name="Volume"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════  UPDATE BANNER  ════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#1210B981"
                BorderBrush="#3010B981"
                BorderThickness="0,0,0,1"
                Padding="20,8"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🆕" FontSize="15" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="Winnow v" Foreground="#6EE7B7"/>
                        <Run Text="{Binding UpdateVersion, Mode=OneWay}" FontWeight="Bold" Foreground="#6EE7B7"/>
                        <Run Text=" is available" Foreground="#A7F3D0"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Download progress (shown while downloading) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Downloading…" FontSize="12" Foreground="#6EE7B7"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Maximum="100"
                                     Width="100" Height="8" VerticalAlignment="Center"
                                     Foreground="#10B981" Background="#1A10B981"/>
                        <TextBlock Text="{Binding UpdateDownloadProgress, Mode=OneWay, StringFormat={}{0}%}"
                                   FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                    <!-- Install button (hidden while downloading) -->
                    <Button x:Name="InstallUpdateBtn"
                            Command="{Binding InstallUpdateCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Cursor="Hand"
                            ToolTip="Download and install the update (app will restart)"
                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisInv}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Setter Property="Background" Value="#10B981"/>
                                <Setter Property="BorderBrush"  Value="#059669"/>
                                <Setter Property="Foreground"   Value="White"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇ " FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Download &amp; Install"/>
                        </StackPanel>
                    </Button>
                    <!-- Dismiss -->
                    <Button Command="{Binding DismissUpdateCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6,4"
                            ToolTip="Dismiss this update notification">
                        <TextBlock Text="✕" FontSize="13" Foreground="#6EE7B7"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════  FOLDER PICKER  ════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource PathTextBoxStyle}"
                         Text="{Binding FolderPath, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButtonStyle}"
                        Command="{Binding BrowseFolderCommand}"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Browse"/>
                    </StackPanel>
                </Button>

                <!-- Browse connected device (MTP / iPhone / Android) -->
                <Button Grid.Column="2"
                        x:Name="BrowseDeviceButton"
                        Style="{StaticResource BrowseButtonStyle}"
                        Click="BrowseDeviceButton_Click"
                        ToolTip="Browse a connected phone or device"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Device"/>
                    </StackPanel>
                </Button>

                <!-- Backup button — visible only when an MTP device is loaded -->
                <Button Grid.Column="3"
                        x:Name="BackupDeviceButton"
                        Style="{StaticResource BrowseButtonStyle}"
                        Click="BackupDeviceButton_Click"
                        ToolTip="Copy folders from connected device to PC"
                        Margin="0,0,10,0"
                        Visibility="{Binding IsMtpSource, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Backup"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ReloadCommand}"
                        ToolTip="Reload with current filters"
                        AutomationProperties.Name="Reload with current filters"
                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="↺ Reload"/>
                </Button>

                <!-- Folder presets dropdown -->
                <Button Grid.Column="5"
                        x:Name="PresetsButton"
                        Style="{StaticResource BaseButtonStyle}"
                        Click="PresetsButton_Click"
                        Margin="6,0,0,0"
                        ToolTip="Pinned folders — quick access"
                        AutomationProperties.Name="Pinned folders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📌" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="Presets"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="PresetsPopup"
                       PlacementTarget="{Binding ElementName=PresetsButton}"
                       Placement="Bottom"
                       StaysOpen="False">
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="200">
                        <StackPanel x:Name="PresetsStack">
                            <!-- Filled from code-behind -->
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ════════════════  FILTER BAR  ═══════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10"
                Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
            <DockPanel VerticalAlignment="Center">

                <!-- View mode toggle buttons (right side) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="View:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="SwipeModeBtn"
                            Content="🃏 Swipe"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="SwipeModeBtn_Click"
                            Tag="Swipe">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSwipeMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="GridModeBtn"
                            Content="⊞ Grid"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            Click="GridModeBtn_Click"
                            Tag="Grid">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ListModeBtn"
                            Content="☰ List"
                            FontSize="12"
                            Padding="10,5"
                            Cursor="Hand"
                            Click="ListModeBtn_Click"
                            Tag="List">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                        <Setter Property="Background" Value="#1A7C3AED"/>
                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Existing filter controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Type:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TypeFilterCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="TypeFilterCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Modified:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DateFilterCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="DateFilterCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Sort:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="SortCombo_SelectionChanged"/>
                </StackPanel>

                <!-- Subfolders toggle pill -->
                <Border x:Name="SubfolderPill"
                        CornerRadius="14"
                        Padding="10,4"
                        Margin="0,0,16,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="SubfolderPill_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SubfolderCheckMark"
                                   Text="📂"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Subfolders"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubfolderOnBadge"
                                   Text=" ON"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrandBrush}"
                                   Visibility="{Binding IncludeSubfolders, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="SubfolderOffBadge"
                                   Text=" OFF"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IncludeSubfolders, Converter={StaticResource BoolToVisInv}}"/>
                    </StackPanel>
                </Border>

                <!-- Scan status indicator -->
                <TextBlock FontSize="12" Foreground="{StaticResource AccentBucketBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding ScanStatusText}"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,12,0"/>

                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding QueueInfo}"/>

                <!-- Total size of files matching current filters -->
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                    <Run Text="·" Foreground="{StaticResource BorderSubtleBrush}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding FilteredTotalSizeFormatted, Mode=OneWay}"
                         Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    <Run Text=" total"/>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════  SESSION BANNER  ══════════════════════════ -->
        <Border Grid.Row="4"
                Background="#1A3B82F6"
                BorderBrush="#4A3B82F6"
                BorderThickness="0,0,0,1"
                Padding="24,8"
                Visibility="{Binding HasSessionBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding SessionBanner}"
                           FontSize="13" Foreground="#A0C4FF"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="4"
                        Command="{Binding StartFreshCommand}"
                        ToolTip="Clear saved session and restart from the beginning">
                    <TextBlock Text="Start fresh ↺" FontSize="12"
                               Foreground="#6A90C0"
                               TextDecorations="Underline"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════  MAIN AREA  ════════════════════════════ -->
        <Grid Grid.Row="5" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Card + Action buttons ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Swipe mode -->
                <views:CardStackControl Grid.Row="0"
                                        x:Name="CardStack"
                                        DataContext="{Binding}"
                                        Focusable="True"
                                        Visibility="{Binding IsSwipeMode, Converter={StaticResource BoolToVis}}"/>

                <!-- Grid mode -->
                <views:FileGridView Grid.Row="0"
                                    x:Name="GridView"
                                    DataContext="{Binding}"
                                    Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>

                <!-- List mode -->
                <views:FileListView Grid.Row="0"
                                    x:Name="ListView"
                                    DataContext="{Binding}"
                                    Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}"/>

                <!-- Action Buttons -->
                <Grid Grid.Row="1" Margin="0,24,0,0"
                      Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <!-- UNDO button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0"
                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding UndoCommand}"
                                    ToolTip="Undo last delete (Ctrl+Z)"
                                    AutomationProperties.Name="Undo last delete"
                                    Padding="10,10"
                                    Margin="0,0,0,6">
                                <TextBlock Text="↩" FontSize="18"/>
                            </Button>
                            <TextBlock Text="Undo" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- DELETE button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                            <Button Style="{StaticResource DeleteButtonStyle}"
                                    Click="DeleteButton_Click"
                                    ToolTip="Delete (← arrow key)"
                                    AutomationProperties.Name="Delete file"
                                    Margin="0,0,0,6">
                                <TextBlock Text="✕"/>
                            </Button>
                            <TextBlock Text="Delete" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- BUCKET button -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                            <Button Style="{StaticResource BucketButtonStyle}"
                                    x:Name="BucketButton"
                                    Click="BucketButton_Click"
                                    AutomationProperties.Name="Add to review bucket"
                                    Margin="0,0,0,6">
                                <TextBlock Text="🪣"/>
                            </Button>
                            <TextBlock Text="Bucket (B)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- KEEP button -->
                        <StackPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource KeepButtonStyle}"
                                    Click="KeepButton_Click"
                                    ToolTip="Keep (→ arrow key)"
                                    AutomationProperties.Name="Keep file"
                                    Margin="0,0,0,6">
                                <TextBlock Text="✓"/>
                            </Button>
                            <TextBlock Text="Keep" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── Right: Stats + Buckets panel ── -->
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">

                <!-- Recently Deleted toggle button -->
                <Grid Margin="0,0,0,10"
                      Visibility="{Binding HasDeletedEntries, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RECENTLY DELETED"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleDeletedPanelCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4,2"
                            ToolTip="Show/hide deleted files panel"
                            AutomationProperties.Name="Toggle deleted files panel">
                        <Border Background="#1AFF6B6B" CornerRadius="10" Padding="6,2">
                            <TextBlock Text="{Binding DeletedEntries.Count}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#FF6B6B"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- Deleted files panel -->
                <views:DeletedFilesPanel DataContext="{Binding}"
                                         Visibility="{Binding ShowDeletedPanel, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,0,14"/>

                <TextBlock Text="SESSION STATS"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"
                           AutomationProperties.HeadingLevel="Level2"/>

                <views:StatsPanel DataContext="{Binding}" Margin="0,0,0,12"/>

                <Button Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ResetStatsCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,20">
                    <TextBlock Text="↺ Reset stats"/>
                </Button>

                <!-- Review Buckets section -->
                <Grid Margin="0,0,0,10"
                      Visibility="{Binding HasBuckets, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="REVIEW BUCKETS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <Button Grid.Column="1"
                            x:Name="NewBucketButton"
                            Click="NewBucketHeader_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4,2"
                            ToolTip="Create new bucket"
                            AutomationProperties.Name="Create new bucket">
                        <TextBlock Text="⊕" FontSize="16"
                                   Foreground="{StaticResource AccentBucketBrush}"/>
                    </Button>
                </Grid>

                <views:BucketsPanel x:Name="BucketsPanelControl"
                                    Visibility="{Binding HasBuckets, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16"/>

                <!-- Tip box -->
                <Border Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12"
                        AutomationProperties.Name="Keyboard shortcuts">
                    <StackPanel>
                        <TextBlock Text="⌨ Keyboard shortcuts"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"
                                   AutomationProperties.HeadingLevel="Level3"/>

                        <!-- Shortcut rows: kbd badge + label -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="←" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Delete file" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="→" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Keep file" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="B" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Add to new bucket" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="O" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Open in default app" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="4,3" HorizontalAlignment="Center">
                                <TextBlock Text="L" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" FontFamily="Consolas, Courier New, Monospace"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Open file location" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
