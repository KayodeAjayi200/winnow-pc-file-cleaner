<Window x:Class="FileTinder.Views.MtpFolderInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Device Folders"
        Width="500" Height="540"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1a1a2e"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Breadcrumb bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#12122a"
                BorderBrush="#2a2a45"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button x:Name="UpBtn"
                        DockPanel.Dock="Right"
                        Content="↑ Up"
                        FontSize="12"
                        Padding="10,5"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        Click="Up_Click"
                        IsEnabled="False"
                        Background="#2a2a45"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="#3a3a55"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BreadcrumbControl" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}"
                                            Tag="{Binding}"
                                            Click="BreadcrumbSegment_Click"
                                            FontSize="12"
                                            Foreground="#a0a0c0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0"
                                            Cursor="Hand"/>
                                    <TextBlock Text=" ›"
                                               Foreground="#444466"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="2,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Folder list ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Visible">
                <TextBlock Text="⏳  Loading folders…"
                           FontSize="14"
                           Foreground="#888"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="EmptyLabel"
                       Text="No sub-folders here · use ↑ Up to navigate"
                       FontSize="13"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <ScrollViewer x:Name="FolderScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed"
                          Background="Transparent">
                <ItemsControl x:Name="FolderItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent"
                                    BorderBrush="#22223a"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1e1e40"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel LastChildFill="True">
                                    <!-- Drill-in button on the right -->
                                    <Button DockPanel.Dock="Right"
                                            Content="›"
                                            Tag="{Binding}"
                                            Click="DrillIn_Click"
                                            Background="Transparent"
                                            Foreground="#7C3AED"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            ToolTip="Open this folder"/>
                                    <!-- Checkbox -->
                                    <CheckBox DockPanel.Dock="Left"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="10,0,6,0"
                                              Foreground="White"/>
                                    <!-- Folder icon + name -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,8">
                                        <TextBlock Text="📁"
                                                   FontFamily="Segoe UI Emoji"
                                                   FontSize="16"
                                                   Foreground="White"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#12122a"
                BorderBrush="#2a2a45"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        DockPanel.Dock="Left"
                        Background="#2a2a45"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,8"
                        FontSize="13"
                        Cursor="Hand"/>
                <Button x:Name="ConfirmBtn"
                        DockPanel.Dock="Right"
                        Content="✓  Confirm Selection"
                        Click="Select_Click"
                        Background="#7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="18,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsEnabled="False"/>
                <TextBlock x:Name="SelectionCountLabel"
                           Text="Check folders to select · › to open"
                           FontSize="11"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
