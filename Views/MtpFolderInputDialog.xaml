<Window x:Class="FileTinder.Views.MtpFolderInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Device Folders"
        Width="480" Height="500"
        MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1a1a2e"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Breadcrumb bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#12122a"
                BorderBrush="#2a2a45"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button x:Name="UpBtn"
                        DockPanel.Dock="Right"
                        Content="↑ Up"
                        FontSize="12"
                        Padding="10,4"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        Click="Up_Click"
                        IsEnabled="False"
                        Background="#2a2a45"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="#3a3a55"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BreadcrumbControl" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}"
                                            Tag="{Binding}"
                                            Click="BreadcrumbSegment_Click"
                                            FontSize="12"
                                            Foreground="#a0a0c0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0"
                                            Cursor="Hand"/>
                                    <TextBlock Text=" ›"
                                               Foreground="#444466"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="2,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Folder list ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Visible">
                <TextBlock Text="⏳  Loading folders…"
                           FontSize="14"
                           Foreground="#888"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="EmptyLabel"
                       Text="No sub-folders here — select this folder directly"
                       FontSize="13"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <ListBox x:Name="FolderListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed"
                     MouseDoubleClick="FolderList_DoubleClick"
                     SelectionChanged="FolderList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2a1a5e"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e1e40"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#12122a"
                BorderBrush="#2a2a45"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        DockPanel.Dock="Left"
                        Background="#2a2a45"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,8"
                        FontSize="13"
                        Cursor="Hand"/>
                <Button x:Name="SelectBtn"
                        DockPanel.Dock="Right"
                        Content="✓  Select This Folder"
                        Click="Select_Click"
                        Background="#7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="18,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                <TextBlock x:Name="CurrentPathLabel"
                           Text=""
                           FontSize="11"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
