<UserControl x:Class="FileTinder.Views.DeletedFilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileTinder.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="10" Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="14,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RECENTLY DELETED"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Command="{Binding ToggleDeletedPanelCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="4,2"
                        ToolTip="Close panel"
                        AutomationProperties.Name="Close deleted panel">
                    <TextBlock Text="✕" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- List -->
            <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeletedEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}"
                                    Margin="8,2,8,2" CornerRadius="6" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding File.IconChar}"
                                               FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding File.Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="140"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding File.SizeFormatted}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="  ·  " FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding TimeFormatted}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Restore button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Path=DataContext.RestoreDeletedCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Padding="6,2"
                                            ToolTip="Restore this file"
                                            AutomationProperties.Name="Restore file">
                                        <TextBlock Text="↩" FontSize="14"
                                                   Foreground="{StaticResource AccentBrandBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="No files deleted this session"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,16"
                       Visibility="{Binding HasDeletedEntries, Converter={StaticResource BoolToVisInv}}"/>

            <!-- Footer: Empty Bin -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Recycle Bin" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding RecycleBinSizeFormatted}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding EmptyRecycleBinCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Permanently delete all files in Recycle Bin">
                        <TextBlock Text="🗑 Empty Bin"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
