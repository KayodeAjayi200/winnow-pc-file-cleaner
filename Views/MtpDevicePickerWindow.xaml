<Window x:Class="FileTinder.Views.MtpDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Device"
        Width="580" Height="460"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E1A"
        Foreground="White"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#2A2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A4A"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📱  Browse Connected Device"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,4"/>
            <TextBlock Text="Select a device and folder to scan files from."
                       FontSize="12" Foreground="#888"/>
        </StackPanel>

        <!-- Main content: device list + folder tree -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="DEVICES" FontSize="10" Foreground="#888"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="↻" Click="Refresh_Click"
                            ToolTip="Rescan for devices"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="14" Cursor="Hand"
                            Padding="4,0" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="DeviceList" Style="{StaticResource ListStyle}"
                             SelectionChanged="DeviceList_SelectionChanged"/>
                    <TextBlock x:Name="NoDevicesText"
                               Text="No devices found.&#x0a;Connect a device via USB and make sure it's unlocked."
                               Foreground="#666" FontSize="11"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="8" TextAlignment="Center"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="LoadingDevices"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scanning…" Foreground="#888" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

        <!-- Folder browser (flat list with breadcrumb + checkboxes) -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="FOLDERS"
                       FontSize="10" Foreground="#888"
                       Margin="0,0,0,6" FontWeight="SemiBold"/>

            <!-- Breadcrumb + Up — hidden until device selected -->
            <Border x:Name="BreadcrumbBar"
                    DockPanel.Dock="Top"
                    Background="#12122a"
                    BorderBrush="#2a2a45"
                    BorderThickness="1,1,1,0"
                    Padding="8,5"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="FolderUpBtn"
                            DockPanel.Dock="Right"
                            Content="↑ Up"
                            FontSize="11"
                            Padding="8,4"
                            Margin="6,0,0,0"
                            IsEnabled="False"
                            Click="FolderUp_Click"
                            Style="{StaticResource ActionBtn}"
                            Background="#2a2a45"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FolderBreadcrumb" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Label}"
                                                Tag="{Binding}"
                                                Click="FolderBreadcrumb_Click"
                                                FontSize="11"
                                                Foreground="#a0a0c0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2,0"
                                                Cursor="Hand"/>
                                        <TextBlock Text=" ›" Foreground="#444466"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Folder list area -->
            <Border BorderBrush="#2A2A3A" BorderThickness="1"
                    Background="#1A1A2E">
                <Grid>
                    <!-- Hint shown before device selected -->
                    <TextBlock x:Name="FolderHint"
                               Text="← Select a device to see its folders"
                               Foreground="#666" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Loading spinner -->
                    <StackPanel x:Name="FolderLoadingPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="FolderLoadingText"
                                   Text="Loading folders…" FontSize="12" Foreground="#888"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error state -->
                    <StackPanel x:Name="FolderErrorPanel" Orientation="Vertical"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="12" Visibility="Collapsed">
                        <TextBlock x:Name="FolderErrorLabel"
                                   FontSize="12" Foreground="#EF4444"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="FolderRetryBtn" Content="↺  Retry"
                                Click="FolderRetry_Click"
                                Style="{StaticResource ActionBtn}"
                                Background="#2a2a45"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <TextBlock x:Name="FolderEmptyLabel"
                               Text="No sub-folders here · use ↑ Up to navigate"
                               FontSize="12" Foreground="#555"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- Delete progress overlay (shown while deleting) -->
                    <Grid x:Name="DeleteProgressOverlay" Visibility="Collapsed" Panel.ZIndex="10">
                        <Rectangle Fill="#CC0E0E1A"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DeleteProgressText"
                                       Text="Deleting…"
                                       FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="260"/>
                            <TextBlock Text="This may take a while for large folders."
                                       FontSize="11" Foreground="#888"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,6,0,0" MaxWidth="260"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable folder list -->
                    <ScrollViewer x:Name="FolderScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="FolderItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#22223a" BorderThickness="0,0,0,1"
                                            Padding="4,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e1e40"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel LastChildFill="True">
                                            <!-- Drill-in -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="›"
                                                    Tag="{Binding}"
                                                    Click="FolderDrillIn_Click"
                                                    Background="Transparent"
                                                    Foreground="#7C3AED"
                                                    BorderThickness="0"
                                                    Padding="10,6"
                                                    FontSize="18" FontWeight="Bold"
                                                    Cursor="Hand"
                                                    ToolTip="Browse inside this folder"/>
                                            <!-- Delete -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="&#x1F5D1;"
                                                    Tag="{Binding}"
                                                    Click="FolderDelete_Click"
                                                    Background="Transparent"
                                                    Foreground="#EF4444"
                                                    BorderThickness="0"
                                                    Padding="6,6"
                                                    FontSize="14"
                                                    Cursor="Hand"
                                                    ToolTip="Permanently delete this folder and all its contents"/>
                                            <!-- Checkbox -->
                                            <CheckBox DockPanel.Dock="Left"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,4,0"
                                                      Foreground="White"/>
                                            <!-- Name -->
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="0,6">
                                                <TextBlock Text="📁 " FontSize="14"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionBtn}"
                    Background="#2A2A3A" Margin="8,0,0,0"/>
            <Button x:Name="OkButton" Content="Open Folder(s)" Click="Ok_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionBtn}"
                    IsEnabled="False"/>
            <TextBlock x:Name="SelectedPathText"
                       Foreground="#888" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
