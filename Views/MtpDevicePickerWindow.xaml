<Window x:Class="FileTinder.Views.MtpDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Device"
        Width="580" Height="460"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E1A"
        Foreground="White"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#2A2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A4A"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📱  Browse Connected Device"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,4"/>
            <TextBlock Text="Select a device and folder to scan files from."
                       FontSize="12" Foreground="#888"/>
        </StackPanel>

        <!-- Main content: device list + folder tree -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="DEVICES" FontSize="10" Foreground="#888"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="↻" Click="Refresh_Click"
                            ToolTip="Rescan for devices"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="14" Cursor="Hand"
                            Padding="4,0" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="DeviceList" Style="{StaticResource ListStyle}"
                             SelectionChanged="DeviceList_SelectionChanged"/>
                    <TextBlock x:Name="NoDevicesText"
                               Text="No devices found.&#x0a;Connect a device via USB and make sure it's unlocked."
                               Foreground="#666" FontSize="11"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="8" TextAlignment="Center"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="LoadingDevices"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scanning…" Foreground="#888" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Folder tree -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="FOLDERS"
                           FontSize="10" Foreground="#888"
                           Margin="0,0,0,6" FontWeight="SemiBold"/>
                <Grid>
                    <TreeView x:Name="FolderTree"
                              Background="#1A1A2E"
                              BorderBrush="#2A2A3A"
                              BorderThickness="1"
                              Foreground="White"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#7C3AED"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <TextBlock x:Name="FolderHint"
                               Text="← Select a device to see its folders"
                               Foreground="#666" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionBtn}"
                    Background="#2A2A3A" Margin="8,0,0,0"/>
            <Button x:Name="OkButton" Content="Open Folder" Click="Ok_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ActionBtn}"
                    IsEnabled="False"/>
            <TextBlock x:Name="SelectedPathText"
                       Foreground="#888" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
