<UserControl x:Class="FileTinder.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Resources>
        <!-- Card style -->
        <Style x:Key="CleanupCardBorder" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="12"/>
            <Setter Property="Padding"          Value="20"/>
        </Style>

        <!-- Icon background pill -->
        <Style x:Key="IconPill" TargetType="Border">
            <Setter Property="Background"   Value="#1A7C3AED"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width"        Value="52"/>
            <Setter Property="Height"       Value="52"/>
        </Style>

        <!-- Scan/Clean primary button -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background"   Value="#7C3AED"/>
            <Setter Property="BorderBrush"  Value="#6D28D9"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="15"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="32,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32">

            <!-- ── Header ── -->
            <TextBlock Text="🧹 Cleanup"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Save disk space and improve your computer's performance"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,28"/>

            <!-- ── Three cards ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Basic Cleanup -->
                <Border Grid.Column="0" Style="{StaticResource CleanupCardBorder}"
                        x:Name="BasicCard">
                    <Grid>
                        <!-- Checkbox top-left -->
                        <CheckBox x:Name="BasicCheck"
                                  IsChecked="True"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="-4,-4,0,0"
                                  Foreground="{StaticResource AccentBrandBrush}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,0">
                            <!-- icon -->
                            <Border Style="{StaticResource IconPill}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="🗑️" FontSize="22" FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Basic Cleanup"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="User temp files &amp; prefetch"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                            <!-- Size badge (shown after scan) -->
                            <Border x:Name="BasicSizeBadge"
                                    Background="#1A10B981" CornerRadius="8"
                                    Padding="10,4" Margin="0,12,0,0"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="BasicSizeText"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System Cleanup -->
                <Border Grid.Column="2" Style="{StaticResource CleanupCardBorder}"
                        x:Name="SystemCard">
                    <Grid>
                        <CheckBox x:Name="SystemCheck"
                                  IsChecked="True"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="-4,-4,0,0"
                                  Foreground="{StaticResource AccentBrandBrush}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Border Style="{StaticResource IconPill}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="💿" FontSize="22" FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="System Cleanup"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Windows temp, update cache &amp; crash dumps"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                            <Border x:Name="SystemSizeBadge"
                                    Background="#1A10B981" CornerRadius="8"
                                    Padding="10,4" Margin="0,12,0,0"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="SystemSizeText"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Privacy Cleanup -->
                <Border Grid.Column="4" Style="{StaticResource CleanupCardBorder}"
                        x:Name="PrivacyCard">
                    <Grid>
                        <CheckBox x:Name="PrivacyCheck"
                                  IsChecked="True"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="-4,-4,0,0"
                                  Foreground="{StaticResource AccentBrandBrush}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Border Style="{StaticResource IconPill}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="🔒" FontSize="22" FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Privacy Cleanup"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Recent files, browser cache &amp; traces"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                            <Border x:Name="PrivacySizeBadge"
                                    Background="#1A10B981" CornerRadius="8"
                                    Padding="10,4" Margin="0,12,0,0"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="PrivacySizeText"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Status / progress text ── -->
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Visibility="Collapsed"/>

            <!-- ── Progress bar ── -->
            <ProgressBar x:Name="ScanProgress"
                         IsIndeterminate="True"
                         Height="4"
                         Margin="0,10,0,0"
                         Foreground="{StaticResource AccentBrandBrush}"
                         Background="{StaticResource BgSurfaceBrush}"
                         Visibility="Collapsed"/>

            <!-- ── Result summary (after scan) ── -->
            <Border x:Name="ResultBanner"
                    Background="#1A10B981"
                    BorderBrush="#3010B981"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,14"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✅ " FontSize="16" FontFamily="Segoe UI Emoji"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultText"
                               FontSize="14" Foreground="#6EE7B7"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Action button (Scan / Clean / Done) ── -->
            <Button x:Name="ActionButton"
                    Style="{StaticResource PrimaryActionButton}"
                    HorizontalAlignment="Center"
                    Margin="0,28,0,0"
                    Click="ActionButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ActionIcon"  Text="🔍 " FontFamily="Segoe UI Emoji" FontSize="15"/>
                    <TextBlock x:Name="ActionLabel" Text="Scan" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- ── Detail list (shown after scan) ── -->
            <Border x:Name="DetailSection"
                    Margin="0,24,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Scan details"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <ItemsControl x:Name="DetailList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80" MinWidth="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileCountText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrandBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Scheduled Cleanup ── -->
            <Border Margin="0,32,0,0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <StackPanel>
                    <!-- Header row -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⏰ Scheduled Cleanup"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Set up a regular cleanup to run automatically and keep your PC free from junk files"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Enable toggle -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <TextBlock x:Name="ScheduleStatusLabel"
                                       Text="Disabled"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <CheckBox x:Name="ScheduleEnabledCheck"
                                      Foreground="{StaticResource AccentBrandBrush}"
                                      VerticalAlignment="Center"
                                      Checked="Schedule_Changed"
                                      Unchecked="Schedule_Changed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Frequency & time (shown when enabled) -->
                    <StackPanel x:Name="ScheduleOptionsPanel" Visibility="Collapsed">
                        <!-- Frequency -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Frequency:"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="80"/>
                            <RadioButton x:Name="FreqDaily"
                                         Content="Daily"
                                         IsChecked="True"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,16,0"
                                         VerticalAlignment="Center"
                                         Checked="Schedule_Changed"/>
                            <RadioButton x:Name="FreqWeekly"
                                         Content="Weekly"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,16,0"
                                         VerticalAlignment="Center"
                                         Checked="Schedule_Changed"/>
                        </StackPanel>

                        <!-- Day of week (weekly only) -->
                        <StackPanel x:Name="WeekDayPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                            <TextBlock Text="Day:"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="80"/>
                            <ComboBox x:Name="WeekDayCombo"
                                      FontSize="13"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Width="120"
                                      SelectionChanged="Schedule_Changed"/>
                        </StackPanel>

                        <!-- Time -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Time:"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="80"/>
                            <ComboBox x:Name="HourCombo"
                                      Width="60"
                                      FontSize="13"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,6,0"
                                      SelectionChanged="Schedule_Changed"/>
                            <TextBlock Text=":"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox x:Name="MinuteCombo"
                                      Width="60"
                                      FontSize="13"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      SelectionChanged="Schedule_Changed"/>
                        </StackPanel>

                        <!-- Save button -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveScheduleBtn"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Padding="20,8"
                                    FontSize="13"
                                    Click="SaveSchedule_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="Save Schedule"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ScheduleSaveStatus"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active schedule indicator -->
                    <Border x:Name="ActiveScheduleBanner"
                            Background="#1A10B981" BorderBrush="#3010B981"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ " FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveScheduleText"
                                       FontSize="12" Foreground="#6EE7B7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
