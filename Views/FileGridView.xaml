<UserControl x:Class="FileTinder.Views.FileGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileTinder.ViewModels"
             xmlns:conv="clr-namespace:FileTinder.Converters"
             x:Name="GridViewRoot">

    <UserControl.Resources>
        <conv:FileItemThumbnailConverter x:Key="ThumbnailConverter"/>
        <BooleanToVisibilityConverter   x:Key="BoolToVis"/>

        <!-- Tile DataTemplate -->
        <DataTemplate x:Key="FileTileTemplate">
            <Border x:Name="TileBorder"
                    Background="#1C2333"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="6"
                    Cursor="Hand"
                    Width="{Binding TileSize, ElementName=GridViewRoot}"
                    Height="{Binding TileSize, ElementName=GridViewRoot}"
                    ClipToBounds="True">

                <Grid>
                    <!-- Thumbnail — loaded async via Shell API -->
                    <Image x:Name="ThumbImage"
                           Source="{Binding FullPath, Converter={StaticResource ThumbnailConverter}, IsAsync=True}"
                           Stretch="UniformToFill"
                           Visibility="Collapsed"/>

                    <!-- Emoji icon (non-image / MTP) -->
                    <TextBlock x:Name="EmojiIcon"
                               Text="{Binding IconChar}"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.7"/>

                    <!-- Bottom metadata bar -->
                    <Border VerticalAlignment="Bottom"
                            Background="#CC0D1117"
                            Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#F0F6FC"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SizeFormatted}"
                                       Foreground="#8B949E"
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Hover overlay -->
                    <Border x:Name="HoverOverlay"
                            Background="#DD0D1117"
                            CornerRadius="10"
                            Opacity="0"
                            Padding="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#F0F6FC"
                                       FontSize="12" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SizeFormatted}"
                                       Foreground="#8B949E"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CategoryLabel}"
                                       Foreground="#7D8590"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <!-- Quick actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Button x:Name="QuickDeleteBtn"
                                        Content="🗑 Delete"
                                        Tag="{Binding}"
                                        Click="QuickDelete_Click"
                                        Background="#3DF85149"
                                        Foreground="#F85149"
                                        BorderBrush="#5DF85149"
                                        BorderThickness="1"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="0,0,4,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="QuickKeepBtn"
                                        Content="✓ Keep"
                                        Tag="{Binding}"
                                        Click="QuickKeep_Click"
                                        Background="#3D2EA44F"
                                        Foreground="#2EA44F"
                                        BorderBrush="#5D2EA44F"
                                        BorderThickness="1"
                                        Padding="8,4"
                                        FontSize="11"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <!-- Open actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="▶ Open"
                                        Tag="{Binding}"
                                        Click="QuickOpen_Click"
                                        Background="#3D0EA5E9"
                                        Foreground="#0EA5E9"
                                        BorderBrush="#5D0EA5E9"
                                        BorderThickness="1"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="0,0,4,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="📂 Location"
                                        Tag="{Binding}"
                                        Click="QuickOpenLocation_Click"
                                        Background="#22FFFFFF"
                                        Foreground="#8B949E"
                                        BorderBrush="#30363D"
                                        BorderThickness="1"
                                        Padding="8,4"
                                        FontSize="11"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Trigger: show thumbnail for image files -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value><ScaleTransform/></Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- Show thumbnail vs emoji via DataTrigger -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter TargetName="ThumbImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="EmojiIcon"  Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: tile size slider -->
        <Border Grid.Row="0"
                Background="#0D1117"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <DockPanel>
                <TextBlock Text="Tile size:"
                           Foreground="#8B949E"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Slider x:Name="TileSizeSlider"
                        Minimum="80" Maximum="240"
                        Value="{Binding TileSize, ElementName=GridViewRoot, Mode=TwoWay}"
                        Width="160"
                        VerticalAlignment="Center"
                        SmallChange="10" LargeChange="40"
                        TickFrequency="20" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding TileSize, ElementName=GridViewRoot, StringFormat={}{0:F0}px}"
                           Foreground="#7D8590"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Scrollable tile area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TileList"
                          ItemTemplate="{StaticResource FileTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
