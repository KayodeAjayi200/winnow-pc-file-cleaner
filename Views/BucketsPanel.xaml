<UserControl x:Class="FileTinder.Views.BucketsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileTinder.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
        <conv:StringToColorConverter x:Key="StrToBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
        <ItemsControl x:Name="BucketList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,10"
                            Padding="0"
                            ClipToBounds="True">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding AccentColor, Converter={StaticResource StrToBrush}}"/>
                        </Border.BorderBrush>

                        <StackPanel>

                            <!-- Accent header strip -->
                            <Border Height="5" CornerRadius="10,10,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding AccentColor, Converter={StaticResource StrToBrush}}"/>
                                </Border.Background>
                            </Border>

                            <!-- Bucket header row -->
                            <Grid Margin="12,8,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Expand toggle -->
                                <Button Grid.Column="0"
                                        Command="{Binding ToggleExpandCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="0,0,6,0" FontSize="14"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        AutomationProperties.Name="Toggle expand">
                                    <TextBlock Text="▾"/>
                                </Button>

                                <!-- VIEW MODE: name + summary -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisInv}}">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="8" Padding="5,1" Margin="0,2,6,0"
                                                Background="#22FFFFFF">
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding DestinationLabel}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="100"
                                                   ToolTip="{Binding DestinationPath}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- RENAME MODE -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                    <Border Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource AccentBucketBrush}"
                                            BorderThickness="0,0,0,1.5" Padding="2,0">
                                        <TextBox Text="{Binding PendingName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" FontWeight="SemiBold"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                                 SelectionBrush="{StaticResource AccentBucketBrush}"
                                                 MinWidth="90" Padding="2,2">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"  Command="{Binding CommitRenameCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Border>
                                    <Button Command="{Binding CommitRenameCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Padding="4,2" ToolTip="Confirm rename"
                                            AutomationProperties.Name="Confirm rename">
                                        <TextBlock Text="✓" FontSize="12"
                                                   Foreground="{StaticResource AccentKeepBrush}"/>
                                    </Button>
                                    <Button Command="{Binding CancelRenameCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Padding="4,2" ToolTip="Cancel"
                                            AutomationProperties.Name="Cancel rename">
                                        <TextBlock Text="✕" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>

                                <!-- Rename bucket -->
                                <Button Grid.Column="2"
                                        Command="{Binding RenameCommand}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisInv}}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="5,4"
                                        ToolTip="Rename bucket"
                                        AutomationProperties.Name="Rename bucket">
                                    <TextBlock Text="✏" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>

                                <!-- Set destination folder -->
                                <Button Grid.Column="3"
                                        Command="{Binding SetDestinationCommand}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisInv}}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="5,4"
                                        ToolTip="Set destination folder"
                                        AutomationProperties.Name="Set destination folder">
                                    <TextBlock Text="📁" FontSize="13"/>
                                </Button>

                                <!-- Apply (move files) -->
                                <Button Grid.Column="4"
                                        Command="{Binding ApplyBucketCommand}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisInv}}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="5,4"
                                        ToolTip="Apply — move all files to destination (or create subfolder)"
                                        AutomationProperties.Name="Apply bucket">
                                    <TextBlock Text="▶" FontSize="13"
                                               Foreground="{StaticResource AccentKeepBrush}"/>
                                </Button>

                                <!-- Delete whole bucket -->
                                <Button Grid.Column="5"
                                        Command="{Binding DeleteBucketCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="5,4"
                                        ToolTip="Delete all files in bucket"
                                        AutomationProperties.Name="Delete all files in bucket">
                                    <TextBlock Text="🗑" FontSize="13"
                                               Foreground="{StaticResource AccentDeleteBrush}"/>
                                </Button>
                            </Grid>

                            <!-- File list (visible when expanded) -->
                            <ItemsControl x:Name="FileList"
                                          ItemsSource="{Binding Files}"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                          Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCardBrush}"
                                                Margin="10,2,10,2" CornerRadius="6" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding IconChar}"
                                                           FontSize="18" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"/>
                                                    <TextBlock Text="{Binding SizeFormatted}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}, Path=DataContext.KeepFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="4,2"
                                                        ToolTip="Keep this file"
                                                        AutomationProperties.Name="Keep this file">
                                                    <TextBlock Text="✅" FontSize="12"/>
                                                </Button>

                                                <Button Grid.Column="3"
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}, Path=DataContext.DeleteFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="4,2"
                                                        ToolTip="Delete this file"
                                                        AutomationProperties.Name="Delete this file">
                                                    <TextBlock Text="🗑" FontSize="12"
                                                               Foreground="{StaticResource AccentDeleteBrush}"/>
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}, Path=DataContext.RemoveFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="4,2"
                                                        ToolTip="Remove from bucket"
                                                        AutomationProperties.Name="Remove from bucket">
                                                    <TextBlock Text="✕" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

