<Window x:Class="FileTinder.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Width="520" Height="540"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Return" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,24,28,16"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="🎉  What's new"
                           FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="VersionText"
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Notes body -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,16,24,8">
            <StackPanel x:Name="NotesPanel" Margin="0,0,0,8"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="28,14,28,20"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Button Content="Got it  ✓"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="{StaticResource AccentBrandBrush}"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="24,9"
                    Click="GotIt_Click"/>
        </Border>
    </Grid>
</Window>
