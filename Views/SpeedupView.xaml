<UserControl x:Class="FileTinder.Views.SpeedupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileTinder.Converters"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <conv:EnabledStatusConverter   x:Key="EnabledStatus"/>

        <Style x:Key="SpeedupTabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontFamily"      Value="{StaticResource MainFont}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0,14"/>
            <Setter Property="Margin"          Value="0,0,36,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4A6FA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeedupTabBtnActive" TargetType="Button" BasedOn="{StaticResource SpeedupTabBtn}">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderThickness="0,0,0,3" BorderBrush="#3B82F6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeedupPrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background"  Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="40,14"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20,16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                <Button x:Name="TabEasyBtn"    Content="Easy Speedup"  Style="{StaticResource SpeedupTabBtnActive}" Click="Tab_Click" Tag="Easy"/>
                <Button x:Name="TabBootBtn"    Content="My Boot Time"  Style="{StaticResource SpeedupTabBtn}"       Click="Tab_Click" Tag="Boot"/>
                <Button x:Name="TabManualBtn"  Content="Manual"        Style="{StaticResource SpeedupTabBtn}"       Click="Tab_Click" Tag="Manual"/>
                <Button x:Name="TabHistoryBtn" Content="History"       Style="{StaticResource SpeedupTabBtn}"       Click="Tab_Click" Tag="History"/>
            </StackPanel>
        </Border>

        <!-- ===== EASY SPEEDUP PANEL ===== -->
        <ScrollViewer x:Name="EasyPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Idle -->
                <StackPanel x:Name="EasyIdle" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,60">
                    <Border Width="150" Height="150" CornerRadius="75" HorizontalAlignment="Center" Margin="0,0,0,32">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#0D2040" Offset="0"/>
                                <GradientStop Color="#06111F" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border Width="118" Height="118" CornerRadius="59" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#1A3C6A" Offset="0"/>
                                    <GradientStop Color="#0F2040" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x1F680;" FontSize="54" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <TextBlock Text="Easy Speedup" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Speed up your computer performance and startup time" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,36"/>
                    <Button Style="{StaticResource SpeedupPrimaryBtn}" HorizontalAlignment="Center" Click="ScanNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A1; " FontFamily="Segoe UI Emoji" FontSize="15"/>
                            <TextBlock Text="Scan now" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Scanning -->
                <StackPanel x:Name="EasyScanning" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,80">
                    <TextBlock Text="&#x1F50D; Scanning startup programs..." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Width="300" Height="4" Foreground="#3B82F6" Background="{StaticResource BgSurfaceBrush}"/>
                </StackPanel>

                <!-- Results -->
                <StackPanel x:Name="EasyResults" Visibility="Collapsed" Margin="40,28,40,40">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock x:Name="HighCountText" FontSize="28" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                <TextBlock Text="High impact" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock x:Name="MedCountText" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Medium impact" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock x:Name="LowCountText" FontSize="28" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                <TextBlock Text="Low impact" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button x:Name="OptimizeBtn" Style="{StaticResource SpeedupPrimaryBtn}" HorizontalAlignment="Center" Margin="0,0,0,16" Click="Optimize_Click">
                        <TextBlock x:Name="OptimizeBtnText" Text="&#x26A1; Disable all high-impact items" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                    <!-- Good startup banner (shown when nothing to optimize) -->
                    <Border x:Name="OptimizeGoodBanner" Background="#1A10B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,16" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="✅ Your startup looks great — no high or medium impact items found!" FontSize="13" Foreground="#6EE7B7"/>
                    </Border>
                    <Border x:Name="OptimizeBanner" Background="#1A10B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,16" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock x:Name="OptimizeBannerText" FontSize="13" Foreground="#6EE7B7"/>
                    </Border>
                    <Border x:Name="HighImpactSection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="High impact startup programs" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="HighImpactList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding LocationLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#33EF4444" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="High" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding IsEnabled, Converter={StaticResource EnabledStatus}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="ScanNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x21BA; " FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Scan again"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== MY BOOT TIME PANEL ===== -->
        <ScrollViewer x:Name="BootPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32">
                <TextBlock Text="My Boot Time" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="How long your PC takes to fully start up" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,28"/>

                <!-- Hero: Boot Duration -->
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Last Boot Duration" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BootDurationText" FontSize="40" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrandBrush}"/>
                            <TextBlock x:Name="BootDurationSubText" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="⏱️" FontSize="40"
                                   FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </Border>

                <!-- Uptime + Stats row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="UptimeText" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="PC uptime" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock x:Name="UptimeSubText" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="StartupCountText" FontSize="22" FontWeight="Bold"
                                       Foreground="#3B82F6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Startup programs" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="BootHealthText" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Boot health" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="BootWarning" Background="#1A2520" BorderBrush="#2A4535" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,4">
                            <Run Text="&#x26A0;&#xFE0F; " FontFamily="Segoe UI Emoji"/>
                            <Run x:Name="BootWarningTitle"/>
                        </TextBlock>
                        <TextBlock x:Name="BootWarningDetail" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Left" Click="BootTabScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BA; " FontFamily="Segoe UI Emoji"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== MANUAL PANEL ===== -->
        <Grid x:Name="ManualPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="40,20,40,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Manual Startup Manager" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Enable or disable individual startup programs" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BaseButtonStyle}" Padding="12,6" FontSize="12" Click="ManualRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x21BA; " FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ManualList" Margin="40,8,40,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#336B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Impact}" Value="High">
                                                        <Setter Property="Background" Value="#33EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                        <Setter Property="Background" Value="#33F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Impact}" Value="Low">
                                                        <Setter Property="Background" Value="#3310B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ImpactLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ImpactColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding LocationLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Button Grid.Column="3" Tag="{Binding}" Click="ManualToggle_Click" Padding="10,5" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="{Binding CanToggle}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground"  Value="#EF4444"/>
                                                        <Setter Property="BorderBrush" Value="#3DEF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground"  Value="#10B981"/>
                                                        <Setter Property="BorderBrush" Value="#3D10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding IsEnabled, Converter={StaticResource EnabledStatus}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===== HISTORY PANEL ===== -->
        <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="40,20,40,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Speedup History" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,16,40,24">
                    <TextBlock x:Name="HistoryEmptyText" Text="No speedup actions recorded yet." FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="{Binding Action}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding ItemName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:MMM d, yyyy HH:mm}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
