<Window x:Class="FileTinder.Views.MtpCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Device Folders"
        Width="620" Height="580"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Checkbox style -->
        <Style x:Key="FolderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#4ade80"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#86efac"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Source info -->
            <RowDefinition Height="Auto"/>  <!-- Folder list label -->
            <RowDefinition Height="*"/>     <!-- Folder checklist -->
            <RowDefinition Height="Auto"/>  <!-- Destination -->
            <RowDefinition Height="Auto"/>  <!-- Options -->
            <RowDefinition Height="Auto"/>  <!-- Progress -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📂  Backup Device Folders"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="DeviceNameText"
                       Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Source folder row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SOURCE FOLDER" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="SourcePathText"
                           FontSize="13" Foreground="#ccc"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Change"
                    Style="{StaticResource SecondaryBtn}"
                    VerticalAlignment="Bottom" Margin="8,0,0,0"
                    Click="ChangeSource_Click"/>
        </Grid>

        <!-- Folders label + select-all -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="SELECT FOLDERS TO COPY" Style="{StaticResource SectionLabel}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="All" FontSize="11"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="8,4" Margin="0,0,6,0"
                    Click="SelectAll_Click"/>
            <Button Grid.Column="2" Content="None" FontSize="11"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="8,4"
                    Click="SelectNone_Click"/>
        </Grid>

        <!-- Folder checklist -->
        <Border Grid.Row="3" Background="#111" CornerRadius="8"
                Margin="0,0,0,16" Padding="8">
            <Grid>
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="220">
                    <ProgressBar IsIndeterminate="True"
                                 Height="4" Margin="0,0,0,12"
                                 Background="#333" Foreground="#4ade80"
                                 BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="#333" CornerRadius="2" ClipToBounds="True">
                                    <Border x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator"
                                                Background="#4ade80" CornerRadius="2"
                                                HorizontalAlignment="Left"/>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock x:Name="LoadingText"
                               Text="Connecting to device…"
                               Foreground="#aaa" FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingSubText"
                               Text=""
                               Foreground="#666" FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Folder list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              x:Name="FolderScrollViewer"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="FoldersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="4" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#222"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="13" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FileCountText}"
                                                   FontSize="11" Foreground="#888"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SizeText}"
                                                   FontSize="12" Foreground="#4ade80"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MinWidth="70" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyText"
                           Text="No sub-folders found in the selected path."
                           Foreground="#666" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Destination -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DESTINATION FOLDER" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="DestPathText"
                           FontSize="13" Foreground="#ccc"
                           TextTrimming="CharacterEllipsis"
                           Text="(no destination selected)"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Browse…"
                    Style="{StaticResource SecondaryBtn}"
                    VerticalAlignment="Bottom" Margin="8,0,0,0"
                    Click="BrowseDest_Click"/>
        </Grid>

        <!-- Options -->
        <CheckBox Grid.Row="5" x:Name="SkipExistingCheck"
                  Content="Skip files that already exist at the destination"
                  IsChecked="True"
                  Style="{StaticResource FolderCheckBoxStyle}"
                  Margin="0,0,0,16"/>

        <!-- Progress area -->
        <StackPanel Grid.Row="6" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <!-- Thumbnail + stats row -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Live thumbnail of currently copied file -->
                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6"
                        Background="#111" Margin="0,0,12,0"
                        x:Name="ThumbBorder" Visibility="Collapsed">
                    <Image x:Name="ThumbImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <!-- Count + bytes -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressLabel"
                               FontSize="12" Foreground="#ccc"/>
                    <TextBlock x:Name="EtaText"
                               FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Speed + pct -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ProgressPctText"
                               FontSize="12" Foreground="#4ade80" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SpeedText"
                               FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="CopyProgressBar"
                         Height="8" Minimum="0" Maximum="100"
                         Foreground="#4ade80" Background="#333"
                         BorderThickness="0">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#333" CornerRadius="4">
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator"
                                        Background="#4ade80"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
            <TextBlock x:Name="CurrentFileText"
                       FontSize="11" Foreground="#666"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="ErrorCountText"
                       FontSize="11" Foreground="#f97316"
                       Margin="0,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Foreground="#888" FontSize="12"
                       VerticalAlignment="Center"/>

            <!-- Appears after a successful copy -->
            <Button Grid.Column="1" x:Name="DeleteFromDeviceBtn"
                    Content="🗑 Delete from Device"
                    FontSize="12"
                    Padding="12,7"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="DeleteFromDevice_Click"
                    Background="#7f1d1d"
                    Foreground="White"
                    BorderThickness="0"/>

            <Button Grid.Column="2" x:Name="CancelBtn"
                    Content="Cancel" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Grid.Column="3" x:Name="CopyBtn"
                    Content="Copy Selected"
                    Style="{StaticResource PrimaryBtn}"
                    IsEnabled="False"
                    Click="CopySelected_Click"/>
        </Grid>
    </Grid>
</Window>
