<UserControl x:Class="FileTinder.Views.StatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileTinder.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20,16">
        <StackPanel>

            <!-- Progress bar -->
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Progress" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding QueueInfo}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <!-- Progress track -->
                <Border Grid.Row="1" Height="8" CornerRadius="4"
                        Background="{StaticResource BgCardBrush}"
                        AutomationProperties.Name="Progress bar"
                        AutomationProperties.HelpText="{Binding QueueInfo}">
                    <Border x:Name="ProgressFill" Height="8" CornerRadius="4"
                            Background="{StaticResource AccentBrandBrush}"
                            HorizontalAlignment="Left"
                            Width="0">
                        <!-- Width is set in code-behind based on Progress -->
                    </Border>
                </Border>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16"/>

                <!-- Stats grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reviewed -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,12">
                    <TextBlock x:Name="ReviewedText"
                               Text="{Binding FilesReviewed}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="ReviewedScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Reviewed" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Space freed -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,12">
                    <TextBlock x:Name="SpaceFreedText"
                               Text="{Binding SpaceFreedFormatted}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AccentKeepBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="SpaceFreedScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Space freed" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Kept -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,12">
                    <TextBlock x:Name="KeptText"
                               Text="{Binding FilesKept}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentKeepBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="KeptScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Kept" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               AutomationProperties.Name="Files kept"/>
                </StackPanel>

                <!-- Deleted -->
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,12">
                    <TextBlock x:Name="DeletedText"
                               Text="{Binding FilesDeleted}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentDeleteBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="DeletedScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Deleted" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               AutomationProperties.Name="Files deleted"/>
                </StackPanel>

                <!-- Bucketed -->
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,8,0" Grid.ColumnSpan="2">
                    <TextBlock x:Name="BucketedText"
                               Text="{Binding FilesBucketed}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBucketBrush}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="BucketedScale"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="In review buckets" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               AutomationProperties.Name="Files in review buckets"/>
                </StackPanel>

            </Grid>

        </StackPanel>
    </Border>
</UserControl>
